.hidden {
    display: none;
}

.top-bar {
    position: absolute;
    left: 16px;
    top: 12px;
    flex-direction: row;
    align-items: stretch;
}

.shop-button {
    margin: 0 8px 0 0;
    padding: 4px 16px;
    border-width: 3px;
    border-color: rgb(89, 186, 169);
    border-radius: 12px;
    background-color: rgb(150, 196, 185);
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(11, 31, 42);
}

.shop-button:hover {
    background-color: rgb(170, 214, 203);
}

.shop-button:active {
    background-color: rgb(120, 170, 160);
}

.money {
    transition-property: scale;
    transition-duration: 0.12s;
    padding: 4px 16px;
    border-width: 3px;
    border-color: rgb(89, 186, 169);
    border-radius: 12px;
    background-color: rgb(79, 138, 163);
}

.money--bump {
    scale: 1.08 1.08;
}

.money-gain {
    position: absolute;
    left: 16px;
    top: 100%;
    margin-top: 4px;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 230, 120);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(11, 31, 42);
    transition-property: translate, opacity;
    transition-duration: 0.9s;
    transition-timing-function: ease-out;
}

.money-gain--rise {
    translate: 0 -24px;
    opacity: 0;
}

.money-label {
    margin: 0;
    padding: 0;
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(11, 31, 42);
}

.shop-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.shop-window {
    width: 760px;
    padding: 24px 24px 32px 24px;
    align-items: center;
    border-width: 3px;
    border-color: rgb(87, 142, 172);
    border-radius: 14px;
    background-color: rgba(28, 54, 87, 0.92);
}

.shop-title {
    margin: 0 0 20px 0;
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.shop-close-button {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 52px;
    height: 52px;
    margin: 0;
    padding: 0;
    border-width: 2px;
    border-color: rgb(30, 79, 63);
    border-radius: 10px;
    background-color: rgb(54, 126, 102);
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.shop-close-button:hover {
    background-color: rgb(70, 150, 124);
}

.card-section {
    width: 420px;
    padding: 20px;
    align-items: center;
    border-width: 2px;
    border-color: rgb(87, 142, 172);
    border-radius: 10px;
    background-color: rgba(40, 80, 120, 0.5);
}

.card-name {
    margin: 0;
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.card-art {
    width: 190px;
    height: 233px;
    margin: 16px 0;
    background-size: contain;
    background-repeat: no-repeat;
}

.card-buy-row {
    flex-direction: row;
    align-items: center;
}

.card-price {
    margin: 0 8px 0 0;
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.card-buy-button {
    margin: 0;
    padding: 2px 14px;
    border-width: 2px;
    border-color: rgb(30, 79, 63);
    border-radius: 8px;
    background-color: rgb(54, 126, 102);
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.card-buy-button:hover {
    background-color: rgb(70, 150, 124);
}

.card-buy-button:disabled {
    opacity: 0.45;
}

.pack-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Sits on the sand, below the swim area, so it never covers the water. */
.pack-button {
    position: absolute;
    left: 50%;
    bottom: 24px;
    width: 150px;
    height: 184px;
    margin: 0 0 0 -75px;
    padding: 0;
    border-width: 0;
    justify-content: flex-end;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    background-size: contain;
    background-repeat: no-repeat;
    transition-property: scale;
    transition-duration: 0.1s;
}

.pack-button:hover {
    background-color: rgba(0, 0, 0, 0);
    scale: 1.05 1.05;
}

.pack-button:active {
    background-color: rgba(0, 0, 0, 0);
    scale: 0.95 0.95;
}

.pack-count {
    margin: 0 0 22px 0;
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(11, 31, 42);
}

/* One centered row; cards that do not fit run off both screen edges. */
.card-row {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 300px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.fish-card {
    width: 170px;
    /* Keep full size in a crowded row instead of squeezing to fit. */
    flex-shrink: 0;
    margin: 0 8px;
    align-items: center;
    transition-property: scale, opacity, rotate, translate, width, margin-left, margin-right;
    transition-duration: 0.3s;
    /* No overshoot on the size, so a collapsing card never goes below zero width. */
    transition-timing-function: ease-out-back, ease-out-back, ease-out-back, ease-out-back, ease-out, ease-out, ease-out;
}

.fish-card:hover {
    scale: 1.05 1.05;
}

/* Three selector parts outrank .fish-card:hover (two), so a hovered card still pops in, squeezes and spins away
   whatever the rule order in this file. */
.card-row > .fish-card.fish-card--pop {
    width: 0;
    margin: 0;
    scale: 0.5 0.5;
    opacity: 0;
    translate: 0 60px;
}

.card-row > .fish-card.fish-card--squeeze {
    scale: 0.85 1;
}

.card-row > .fish-card.fish-card--collect {
    width: 0;
    margin: 0;
    scale: 0.2 0.2;
    opacity: 0;
    rotate: 270deg;
    translate: 0 80px;
}

.fish-card__name {
    margin: 0;
    padding: 0;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(11, 31, 42);
}

.fish-card__rarity {
    margin: 0 0 4px 0;
    padding: 0;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(11, 31, 42);
}

.fish-card__frame {
    width: 150px;
    height: 203px;
    background-image: url("Images/CardFrame.png");
    background-size: contain;
    background-repeat: no-repeat;
}

/* Fits the frame's beige window. */
.fish-card__fish {
    position: absolute;
    left: 10%;
    top: 14%;
    width: 80%;
    height: 48%;
    background-size: contain;
    background-repeat: no-repeat;
}
