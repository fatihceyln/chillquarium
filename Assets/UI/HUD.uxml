<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="HUD.uss" />
    <ui:VisualElement name="pack-layer" class="pack-layer" picking-mode="Ignore">
        <ui:VisualElement name="card-row" class="card-row" picking-mode="Ignore" />
        <ui:Button name="pack-button" class="pack-button hidden">
            <ui:Label name="pack-count-label" text="x0" class="pack-count" picking-mode="Ignore" />
        </ui:Button>
    </ui:VisualElement>
    <ui:VisualElement name="top-bar" class="top-bar">
        <ui:Button name="shop-button" text="Shop" class="shop-button" />
        <ui:VisualElement name="money" class="money">
            <ui:Label name="money-label" text="$0.00" class="money-label" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="shop-panel" class="shop-overlay hidden">
        <ui:VisualElement class="shop-window">
            <ui:Label text="Shop" class="shop-title" />
            <ui:Button name="shop-close-button" text="X" class="shop-close-button" />
            <ui:VisualElement class="card-section">
                <ui:Label name="card-name-label" text="Fish Card" class="card-name" />
                <ui:VisualElement name="card-art" class="card-art" />
                <ui:VisualElement class="card-buy-row">
                    <ui:Label name="card-price-label" text="$0.00" class="card-price" />
                    <ui:Button name="card-buy-button" text="Buy" class="card-buy-button" />
                </ui:VisualElement>
                <ui:VisualElement class="card-buy-row card-bulk-buy-row">
                    <ui:Label name="card-bulk-price-label" text="$0.00" class="card-price" />
                    <ui:Button name="card-bulk-buy-button" text="Buy x5" class="card-buy-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="discovery-panel" class="discovery-overlay hidden">
        <ui:VisualElement name="discovery-window" class="discovery-window">
            <ui:Label text="New fish discovered!" class="discovery-title" />
            <ui:VisualElement name="discovery-fish" class="discovery-fish" />
            <ui:Label name="discovery-name-label" text="Fish" class="discovery-name" />
            <ui:Label name="discovery-rarity-label" text="Common" class="discovery-rarity" />
            <ui:Button name="discovery-ok-button" text="OK" class="card-buy-button discovery-ok-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
