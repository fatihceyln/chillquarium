<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <ui:VisualElement name="top-bar" class="top-bar">
        <ui:Button name="shop-button" text="Shop" class="shop-button" />
        <ui:VisualElement name="money" class="money">
            <ui:Label name="money-label" text="$0.00" class="money-label" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="shop-panel" class="shop-overlay hidden" picking-mode="Ignore">
        <ui:VisualElement class="shop-window">
            <ui:Label text="Shop" class="shop-title" />
            <ui:Button name="shop-close-button" text="X" class="shop-close-button" />
            <ui:VisualElement class="card-section">
                <ui:Label text="Freshwater Friends" class="card-name" />
                <ui:VisualElement class="card-art" />
                <ui:VisualElement class="card-buy-row">
                    <ui:Label name="card-price-label" text="$0.00" class="card-price" />
                    <ui:Button name="card-buy-button" text="Buy" class="card-buy-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="reveal-panel" class="reveal-overlay hidden">
        <ui:VisualElement class="reveal-window">
            <ui:Label text="New fish!" class="reveal-title" />
            <ui:Label name="reveal-fish-name-label" text="Fish" class="reveal-fish-name" />
            <ui:Label name="reveal-rarity-label" text="Common" class="reveal-rarity" />
            <ui:VisualElement class="reveal-art-box">
                <ui:VisualElement name="reveal-fish-art" class="reveal-fish-art" />
            </ui:VisualElement>
            <ui:Button name="reveal-confirm-button" text="Awesome!" class="reveal-confirm-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
